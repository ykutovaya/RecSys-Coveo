{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coveo:feature-schema:1",
  "type": "object",
  "required": [
    "schema_version",
    "config_id",
    "event_semantics",
    "columns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "event_semantics": {
      "enum": [
        "set_v1",
        "multiset_v1"
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "position",
          "dtype",
          "formula",
          "mask",
          "transformation",
          "provenance",
          "fit_period"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "dtype": {
            "enum": [
              "float64",
              "int64",
              "bool",
              "category"
            ]
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "mask": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "transformation": {
            "enum": [
              "identity",
              "log1p"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "entity",
              "sources",
              "available_at",
              "version",
              "missing_rule"
            ],
            "additionalProperties": false,
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "available_at": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "missing_rule": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "fit_period": {
            "enum": [
              "A_G",
              "A_N",
              "B",
              "none"
            ]
          }
        }
      }
    }
  }
}
